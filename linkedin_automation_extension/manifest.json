{
  "manifest_version": 3,
  "name": "LinkedIn DOM Sandbox Tester",
  "version": "1.2",
  "description": "Tests pure DOM connection actions with elevated permissions",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}